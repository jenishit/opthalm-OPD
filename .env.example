# Base URL of the OPD backend API (used by services/http.ts).
BACKEND_URL=http://localhost:8090

# NextAuth (Auth.js v5). AUTH_SECRET signs the session JWT — generate with
# `openssl rand -base64 32`. AUTH_TRUST_HOST=true is fine for dev or behind a
# proxy you control.
AUTH_SECRET=dev-secret-change-me-please-32bytes-min
AUTH_TRUST_HOST=true
